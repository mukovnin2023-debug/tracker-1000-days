rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Трекеры: создать может кто угодно, прочитать — только если знаешь
    // точный ID (get), но не перечислить все подряд (list запрещён).
    // Менять/удалять сам трекер после создания нельзя.
    match /trackers/{trackerId} {
      allow get: if true;
      allow list: if false;
      allow create: if true;
      allow update, delete: if false;

      // Записи по дням лежат внутри конкретного трекера — доступны
      // только тому, кто уже знает trackerId (сам путь и есть "ключ").
      match /entries/{day} {
        allow read, write: if true;
      }
    }

    // Агрегированная (обезличенная) статистика для автора: счётчики
    // по сферам и по кликам. Персональных данных здесь нет.
    match /stats/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Всё остальное — закрыто по умолчанию.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
